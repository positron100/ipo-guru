SITE_URL=

# --- Data provider: ipoguru (default) | ipowatch ---
IPO_DATA_PROVIDER=ipoguru

# IPO Guru API key (server-only; never prefix with NEXT_PUBLIC_)
IPOGURU_API_KEY=
# Optional: override the IPO Guru API base URL.
# IPOGURU_BASE_URL=

# How long fetched data is reused before it may refresh (seconds, minimum 60). Pages never call providers directly.
# IPO_DETAILS_REVALIDATE_SECONDS=86400
# IPO_GMP_REVALIDATE_SECONDS=14400
# IPO_SUBSCRIPTION_REVALIDATE_SECONDS=14400

# --- IPO Watch scraper: development / private use only (IPO Watch's terms restrict reuse; replace before any public launch) ---
# IPO_SCRAPER_ENABLED=true
# IPOWATCH_ALLOW_PRODUCTION=true          # needed for `next build`/`next start`; keep unset for any public deployment
# IPOWATCH_BASE_URL=
# IPOWATCH_MIN_REQUEST_GAP_MS=3000
# IPOWATCH_TIMEOUT_MS=10000
# IPOWATCH_MAX_RETRIES=1
# IPOWATCH_BLOCKED_BACKOFF_SECONDS=1800
# IPOWATCH_USER_AGENT=

# --- Contact page (app/api/contact/route.ts) ---------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix), so these never reach the browser bundle.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where letters are delivered.
CONTACT_EMAIL=mukuknegi2005@gmail.com
# The verified sender the mail is actually sent as (an address on a domain verified with Resend; the writer's own address is set
# as Reply-To instead). Resend's shared sender works for testing:
EMAIL_FROM=IPO GMP Desk <onboarding@resend.dev>
